{
  "name": "@a2uiverse/smoke-transport",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/retz8/a2uiverse.git",
    "directory": "packages/smoke-transport"
  },
  "private": true,
  "description": "How the marketplace and Stellify reach an agent: the transport of the smoke request, over @a2a-js/sdk.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/fakeAgent.d.ts",
        "default": "./dist/testing/fakeAgent.js"
      }
    },
    "./testing/v1": {
      "import": {
        "types": "./dist/testing/fakeAgentV1.d.ts",
        "default": "./dist/testing/fakeAgentV1.js"
      }
    },
    "./testing/wire": {
      "import": {
        "types": "./dist/testing/capturedWire.d.ts",
        "default": "./dist/testing/capturedWire.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@a2uiverse/card": "workspace:*",
    "@a2uiverse/sdk": "workspace:*"
  },
  "devDependencies": {
    "@a2a-js/sdk-v0_3": "npm:@a2a-js/sdk@0.3.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "express": "^5.2.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9"
  }
}
