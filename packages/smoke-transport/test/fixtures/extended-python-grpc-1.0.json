{
  "name": "Scratch Shop",
  "description": "A scratch shop that serves each signed-in account a card of its own",
  "supportedInterfaces": [
    {
      "url": "http://127.0.0.1:18751/rest",
      "protocolBinding": "HTTP+JSON",
      "protocolVersion": "1.0"
    },
    {
      "url": "http://127.0.0.1:18751/rest",
