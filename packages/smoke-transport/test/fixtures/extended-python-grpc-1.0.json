  "skills": [
    {
      "id": "shop",
      "name": "Shop",
      "description": "The scratch shop’s front page",
      "tags": ["shop"],
      "examples": ["what is new at the shop"]
    },
    {
      "id": "lanterns",
      "name": "Lantern repairs",
      "description": "The lantern repairs this account has booked with the shop, and their state",
      "tags": ["lanterns"],
      "examples": ["how are my lantern repairs"]
    }
  ]
