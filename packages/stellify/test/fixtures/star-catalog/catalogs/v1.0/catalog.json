{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/star/catalog.json",
  "protocolVersion": "1.0",
  "catalogId": "https://example.com/star/catalog.json",
  "$defs": {
    "anyComponent": {
      "oneOf": [{"$ref": "#/components/StarText"}, {"$ref": "#/components/StarButton"}]
    },
    "anyFunction": false,
    "tone": {"type": "string", "enum": ["calm", "bright"]}
  },
  "components": {
    "StarText": {
      "type": "object",
      "properties": {
        "component": {"const": "StarText"},
        "text": {"$ref": "common_types.json#/$defs/DynamicString"},
        "tone": {"$ref": "#/$defs/tone"}
      },
      "required": ["component", "text"]
    },
    "StarButton": {
      "type": "object",
      "properties": {
        "component": {"const": "StarButton"},
        "label": {"$ref": "common_types.json#/$defs/DynamicString"},
        "action": {"$ref": "common_types.json#/$defs/Action"}
      },
      "required": ["component", "label"]
    }
  }
}
