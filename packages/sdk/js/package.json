{
  "name": "@a2uiverse/sdk",
  "version": "0.3.0",
  "description": "The A2UIVerse composition contract between orchestrator and client, and generic A2UI tools.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "embed-spec": "node scripts/embed-spec.mjs",
    "sync-a2ui-spec": "node scripts/sync-a2ui-spec.mjs",
    "build": "pnpm embed-spec && tsc -p tsconfig.json",
    "typecheck": "pnpm embed-spec && tsc --noEmit",
    "test": "pnpm embed-spec && vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "json-schema-to-ts": "^3.1.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
