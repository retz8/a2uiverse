{
  "name": "@a2uiverse/sdk",
  "version": "0.5.0",
  "description": "The A2UIVerse platform contracts \u2014 composition between orchestrator and client, the catalog export and artifact contracts, and the marketplace's contracts with the checks the marketplace, the registry and Stellify share \u2014 and generic A2UI tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/retz8/a2uiverse.git",
    "directory": "packages/sdk/js"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "embed-spec": "node scripts/embed-spec.mjs",
    "sync-a2ui-spec": "node scripts/sync-a2ui-spec.mjs",
    "build": "pnpm embed-spec && tsc -p tsconfig.json",
    "typecheck": "pnpm embed-spec && tsc --noEmit",
    "test": "pnpm embed-spec && vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "json-schema-to-ts": "^3.1.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@a2ui/web_core": "0.14.0",
    "ajv": "^8.20.0",
    "zod": "^3.25.76"
  }
}
