{
  "name": "A2UI E2E Test Agent",
  "description": "Replays the conformance/e2e scenarios over A2A, in direct_json, for the live-pair end-to-end tests.",
  "protocolVersion": "0.3.0",
  "version": "0.1.0",
  "url": "http://localhost:11011/",
  "defaultInputModes": ["text/plain"],
  "defaultOutputModes": ["text/plain"],
  "skills": [
    {
      "id": "replay_scenario",
      "name": "Replay a scenario",
      "description": "Answers the opening text of a conformance/e2e scenario with that scenario's scripted turns.",
      "tags": ["a2ui", "test"]
    }
  ],
  "capabilities": {
    "streaming": true,
    "extensions": [
      {
        "uri": "https://a2ui.org/a2a-extension/a2ui/v0.9",
        "description": "A2UI v0.9",
        "params": {
          "supportedCatalogIds": ["https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json"]
        }
      },
      {
        "uri": "https://a2ui.org/a2a-extension/a2ui/v1.0",
        "description": "A2UI v1.0",
        "params": {
          "supportedCatalogIds": ["https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"]
        }
      }
    ]
  }
}
