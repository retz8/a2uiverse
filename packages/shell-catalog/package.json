{
  "name": "@a2uiverse/shell-catalog",
  "version": "0.1.0",
  "private": true,
  "description": "The shell's own A2UI catalog: standard catalog plus composition primitives, as schema + React implementation.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./id": {
      "import": {
        "types": "./dist/catalog-id.d.ts",
        "default": "./dist/catalog-id.js"
      }
    },
    "./operators": {
      "import": {
        "types": "./dist/functions/operators.d.ts",
        "default": "./dist/functions/operators.js"
      }
    },
    "./catalog.json": "./catalogs/v0.9.1/catalog.json"
  },
  "files": [
    "dist",
    "catalogs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "dev": "vite dev fixture"
  },
  "dependencies": {
    "@a2uiverse/sdk": "workspace:*"
  },
  "devDependencies": {
    "@a2ui/react": "^0.10.2",
    "@a2ui/web_core": "^0.10.6",
    "@radix-ui/themes": "^3.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@a2ui/react": "^0.10.2",
    "@a2ui/web_core": "^0.10.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.76"
  }
}
