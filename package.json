{
  "name": "a2uiverse",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "turbo run dev",
    "dev:agents": "node scripts/dev-agents.mjs",
    "agents:list": "node scripts/dev-agents.mjs --list",
    "dev:all": "node scripts/dev-agents.mjs --wait-for-cards --then \"pnpm dev\"",
    "dev:client": "pnpm --filter @a2uiverse/client dev",
    "dev:orch": "pnpm --filter @a2uiverse/orchestrator dev",
    "dev:marketplace": "pnpm --filter @a2uiverse/marketplace dev",
    "test:scripts": "node --test scripts/*.test.mjs",
    "verify": "turbo run build typecheck test && pnpm test:scripts && pnpm lint && pnpm format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "turbo": "^2.10.11",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
