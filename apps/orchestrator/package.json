{
  "name": "@a2uiverse/orchestrator",
  "version": "0.0.0",
  "private": true,
  "description": "The A2UIVerse orchestrator: an A2A agent server \u2014 Router, Planner, Synthesizer, AgentsPool, Registry.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "dev": "tsx --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@a2a-js/sdk": "0.3.14",
    "@a2ui/web_core": "^0.10.6",
    "@a2uiverse/sdk": "workspace:*",
    "@a2uiverse/shell-catalog": "workspace:*",
    "@ai-sdk/google": "^4.0.56",
    "@huggingface/transformers": "^4.2.0",
    "ai": "^7.0.83",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@ai-sdk/provider-utils": "^5.0.32",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9"
  }
}
