      "skills": [
        {
          "description": "Lists everything Northlight has in stock right now with its live price and its customer rating, and opens any single line in full. Prices track supplier feeds, so the list is what the warehouse holds today rather than a curated selection.",
          "examples": [
            "What cameras do you have?",
            "Show me your camera stock",
            "How much is the Orbit GM3 at Northlight?",
            "Which of your cameras is rated best?"
          ],
          "id": "browse-cameras",
          "name": "Browse cameras",
          "tags": [
            "cameras",
            "shopping",
            "prices",
            "shop-b"
          ]
        },
        {
          "description": "Answers questions about Northlight's next-day dispatch cutoff, free delivery threshold, and the fourteen-day returns window for unopened stock.",
          "examples": [
            "What is your returns policy?",
