      ],
      "defaultOutputModes": [
        "text",
        "text/plain"
      ],
      "description": "Reads and acts on your Google Calendar: shows what's coming up and what's still unanswered, opens an event with its attendees, proposes a new event for you to confirm, and answers invitations for you.",
      "documentationUrl": "https://github.com/retz8/a2uiverse-apps/blob/main/calendar/agent/README.md",
      "name": "Google Calendar",
      "preferredTransport": "JSONRPC",
      "protocolVersion": "0.3.0",
      "provider": {
        "organization": "Google",
        "url": "https://calendar.google.com"
      },
      "security": [
        {
          "signIn": [
            "calendar.read"
          ]
        }
      ],
      "securitySchemes": {
        "signIn": {
          "flows": {
            "authorizationCode": {
              "authorizationUrl": "http://localhost:11003/oauth/authorize",
              "refreshUrl": "http://localhost:11003/oauth/token",
              "scopes": {
                "calendar.read": "See your calendar",
                "calendar.write": "Add events and answer invitations on your calendar"
              },
              "tokenUrl": "http://localhost:11003/oauth/token"
            }
          },
          "oauth2MetadataUrl": "http://localhost:11003/.well-known/oauth-authorization-server",
          "type": "oauth2"
        }
      },
      "skills": [
        {
          "description": "Finds what your calendar needs from you: what's on today and next, invitations still waiting on your answer, and where your day is double-booked.",
          "examples": [
            "What needs my attention today?",
            "What's on my plate?",
            "Anything I need to deal with this morning?",
            "What's on my calendar today?",
            "What does the rest of my week look like?",
            "Do I have anything I haven't replied to?",
            "Am I double-booked at any point tomorrow?",
            "When is my next meeting?"
          ],
          "id": "agenda_triage",
          "name": "What is coming up",
          "tags": [
            "a2ui",
            "calendar",
            "schedule",
            "agenda",
            "triage"
          ]
        },
        {
          "description": "Opens one event and shows what it is: when and where, who's invited, who has accepted, and the notes that came with it.",
          "examples": [
            "What's the standup about?",
            "Who's coming to the review?",
            "Where is that meeting?",
            "Show me the details of my 2pm",
            "Has anyone declined the planning session?"
          ],
          "id": "event_detail",
          "name": "Looking at one event",
          "tags": [
            "a2ui",
            "calendar",
            "event",
            "attendees"
          ]
        },
        {
          "description": "Proposes a new event — time, title, attendees — and creates it once you confirm.",
          "examples": [
            "Put a half hour with the design team on Thursday",
            "Block out Friday afternoon for writing",
            "Schedule a call with them next week",
            "Add lunch tomorrow at noon"
          ],
          "id": "event_creation",
          "name": "Putting something on the calendar",
          "tags": [
            "a2ui",
            "calendar",
            "event",
            "scheduling",
            "create"
          ]
        },
        {
          "description": "Answers an invitation for you: accept, decline, or mark it tentative.",
          "examples": [
            "Accept the invite for Thursday",
            "Decline the all-hands",
            "Mark me as tentative for that one",
            "Say yes to the design review"
          ],
          "id": "invitation_response",
          "name": "Answering an invitation",
          "tags": [
            "a2ui",
            "calendar",
            "rsvp",
            "invitation"
          ]
        }
      ],
      "url": "http://localhost:11003",
      "version": "0.1.0"
    },
