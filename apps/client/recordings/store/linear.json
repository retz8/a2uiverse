    "card": {
      "capabilities": {
        "extensions": [
          {
            "description": "Provides agent driven UI using the A2UI JSON format.",
            "params": {
              "supportedCatalogIds": [
                "https://github.com/retz8/a2uiverse-apps/blob/main/linear/linear-catalog/catalogs/v0.9.1/catalog.json"
              ]
            },
