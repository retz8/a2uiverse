      },
      "defaultInputModes": [
        "text",
        "text/plain"
      ],
      "defaultOutputModes": [
        "text",
        "text/plain"
      ],
      "description": "Shows the user's Linear issues: what is assigned to them or in a team's queue, by status and priority; an issue's description, comments and linked pull requests. Creates an issue, updates its status, priority, assignee or labels, or comments on it once the user confirms.",
      "documentationUrl": "https://github.com/retz8/a2uiverse-apps/blob/main/linear/agent/README.md",
      "name": "Linear",
      "preferredTransport": "JSONRPC",
      "protocolVersion": "0.3.0",
      "provider": {
        "organization": "Linear",
        "url": "https://linear.app"
      },
      "security": [
        {
          "signIn": [
            "issues.read"
          ]
        }
      ],
      "securitySchemes": {
        "signIn": {
          "flows": {
            "authorizationCode": {
              "authorizationUrl": "http://localhost:11005/oauth/authorize",
              "refreshUrl": "http://localhost:11005/oauth/token",
              "scopes": {
                "issues.read": "See your issues",
                "issues.write": "Create, change and comment on your issues"
              },
              "tokenUrl": "http://localhost:11005/oauth/token"
            }
          },
          "oauth2MetadataUrl": "http://localhost:11005/.well-known/oauth-authorization-server",
          "type": "oauth2"
        }
      },
      "skills": [
        {
          "description": "Lists the user's Linear issues or a team's, with each issue's identifier, title, status and priority — what is in progress, what is up next, what is urgent.",
          "examples": [
            "What's assigned to me in Linear?",
            "What am I working on?",
            "Show my open issues",
            "Anything urgent on my plate?",
            "What's in the team's backlog?",
            "Which issues are in progress?"
          ],
          "id": "my_issues",
          "name": "Issues",
          "tags": [
            "a2ui",
            "linear",
            "issues",
            "tickets",
            "tasks"
          ]
        },
        {
          "description": "Opens one issue: its description, status, priority, assignee and labels, its comments, and the pull requests and branch linked to it.",
          "examples": [
            "Open A2U-5",
            "Show me the issue about the login bug",
            "What's the discussion on that issue?",
            "Is there a pull request for this issue?"
          ],
          "id": "issue_detail",
          "name": "An issue's detail",
          "tags": [
            "a2ui",
            "linear",
            "issue",
            "comments"
          ]
        },
        {
          "description": "Changes an issue's status, priority, assignee or labels, after the user confirms.",
          "examples": [
            "Move A2U-5 to In Progress",
            "Mark it done",
            "Set its priority to high",
            "Assign that issue to me"
          ],
          "id": "issue_updates",
          "name": "Updating an issue",
          "tags": [
            "a2ui",
            "linear",
            "status",
            "priority",
            "assign"
          ]
        },
        {
          "description": "Files a new issue in a team, or adds a comment to an issue, after the user confirms.",
          "examples": [
            "File an issue for the flaky test",
            "Create a bug: the sort order is wrong",
            "Comment on A2U-5 that the fix is up",
            "Add a note to that issue"
          ],
          "id": "create_and_comment",
          "name": "Filing an issue and commenting",
          "tags": [
            "a2ui",
            "linear",
            "create",
            "comment"
          ]
        }
      ],
      "url": "http://localhost:11005",
      "version": "0.1.0"
    },
