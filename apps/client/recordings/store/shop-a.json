      },
      "skills": [
        {
          "description": "Lists the camera bodies Aperture & Co currently has on the shelf, each with its price and the rating its staff gave it after inspection, and opens any one of them in full. The shelf is small and hand-picked rather than a full-range catalogue.",
          "examples": [
            "What cameras do you have?",
            "Show me your camera stock",
            "What does the Lumen X100 cost at Aperture?",
            "Which of your cameras is rated best?"
          ],
          "id": "browse-cameras",
          "name": "Browse cameras",
          "tags": [
            "cameras",
            "shopping",
            "prices",
            "shop-a"
          ]
        },
        {
          "description": "Answers questions about Aperture & Co's dispatch times, its thirty-day returns window, and the twelve-month workshop warranty every graded body carries.",
          "examples": [
            "What is your returns policy?",
            "How fast do you ship?",
            "Do your cameras come with a warranty?"
          ],
          "id": "store-policy",
          "name": "Shipping and returns",
          "tags": [
            "shipping",
            "returns",
            "warranty",
            "shop-a"
          ]
        }
      ],
